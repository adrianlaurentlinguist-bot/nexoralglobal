<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Nexora Global | Language &amp; Localization Solutions</title>
    <script src="https://cloudflare.com"></script>
    <style>
        :root {
            --primary: #0b0f19;
            --secondary: #2563eb;
            --accent: #38bdf8;
            --surface: #1e293b;
            --text-dark: #0f172a;
            --text-muted: #64748b;
            --bg-light: #f8fafc;
            --white: #ffffff;
            --border: #e2e8f0;
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
        }

        body {
            background-color: var(--bg-light);
            color: var(--text-dark);
            line-height: 1.6;
        }

        /* Top Header & Premium Nav */
        header {
            background: var(--white);
            border-bottom: 1px solid var(--border);
            position: sticky;
            top: 0;
            z-index: 1000;
        }

        .nav-container {
            max-width: 1200px;
            margin: 0 auto;
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 1.2rem 2rem;
        }

        .logo {
            font-size: 1.4rem;
            font-weight: 800;
            color: var(--primary);
            letter-spacing: -0.5px;
            text-transform: uppercase;
        }

        .logo span {
            color: var(--secondary);
        }

        nav ul {
            display: flex;
            list-style: none;
            gap: 2.5rem;
        }

        nav a {
            text-decoration: none;
            color: var(--text-muted);
            font-weight: 600;
            font-size: 0.95rem;
            transition: all 0.2s;
            cursor: pointer;
            padding-bottom: 0.5rem;
            border-bottom: 2px solid transparent;
        }

        nav a:hover, nav a.active {
            color: var(--secondary);
            border-bottom-color: var(--secondary);
        }

        /* Screen Switcher Panels */
        .tab-content {
            display: none;
        }

        .tab-content.active {
            display: block;
            animation: panelFade 0.4s cubic-bezier(0.16, 1, 0.3, 1);
        }

        @keyframes panelFade {
            from { opacity: 0; transform: translateY(8px); }
            to { opacity: 1; transform: translateY(0); }
        }

        /* Hero Architecture */
        .hero {
            background: linear-gradient(135deg, #0f172a 0%, #030712 100%);
            color: var(--white);
            padding: 7rem 2rem;
            text-align: center;
            position: relative;
            overflow: hidden;
        }

        .hero::before {
            content: '';
            position: absolute;
            top: -50%;
            left: -50%;
            width: 200%;
            height: 200%;
            background: radial-gradient(circle, rgba(37,99,235,0.1) 0%, transparent 60%);
            pointer-events: none;
        }

        .hero-inner {
            max-width: 850px;
            margin: 0 auto;
            position: relative;
            z-index: 2;
        }

        .hero h1 {
            font-size: 3.5rem;
            font-weight: 800;
            letter-spacing: -1px;
            margin-bottom: 1.5rem;
            line-height: 1.15;
        }

        .hero h1 span {
            background: linear-gradient(to right, #38bdf8, #2563eb);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        .hero p {
            font-size: 1.3rem;
            color: #94a3b8;
            margin-bottom: 3rem;
            font-weight: 400;
        }

        .btn {
            display: inline-block;
            background: var(--secondary);
            color: var(--white);
            padding: 0.9rem 2.2rem;
            border-radius: 6px;
            text-decoration: none;
            font-weight: 600;
            font-size: 1rem;
            transition: all 0.2s;
            border: none;
            cursor: pointer;
            box-shadow: 0 4px 14px rgba(37, 99, 235, 0.3);
        }

        .btn:hover {
            background: #1d4ed8;
            transform: translateY(-1px);
        }

        /* Trust Strip */
        .trust-strip {
            background: var(--white);
            border-bottom: 1px solid var(--border);
            padding: 2rem;
            text-align: center;
        }

        .trust-title {
            font-size: 0.8rem;
            text-transform: uppercase;
            letter-spacing: 1.5px;
            color: var(--text-muted);
            margin-bottom: 1.5rem;
            font-weight: 700;
        }

        .logo-grid {
            display: flex;
            justify-content: center;
            align-items: center;
            gap: 4rem;
            flex-wrap: wrap;
            opacity: 0.6;
        }

        .logo-item {
            font-weight: 700;
            font-size: 1.1rem;
            color: var(--text-dark);
            letter-spacing: -0.5px;
        }

        /* Layout Structure */
        .section {
            padding: 6rem 2rem;
            max-width: 1200px;
            margin: 0 auto;
        }

        .section-header {
            text-align: center;
            max-width: 600px;
            margin: 0 auto 4rem auto;
        }

        .section-header p {
            color: var(--text-muted);
            font-size: 1.1rem;
            margin-top: 0.5rem;
        }

        .section-title {
            font-size: 2.4rem;
            font-weight: 800;
            color: var(--primary);
            letter-spacing: -0.5px;
        }

        /* Premium Grid & Cards */
        .grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
            gap: 2rem;
        }

        .card {
            background: var(--white);
            padding: 3rem 2.5rem;
            border-radius: 8px;
            border: 1px solid var(--border);
            transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
        }

        .card:hover {
            transform: translateY(-4px);
            box-shadow: 0 12px 24px rgba(15, 23, 42, 0.04);
            border-color: #cbd5e1;
        }

        .card-icon {
            width: 3rem;
            height: 3rem;
            background: #eff6ff;
            color: var(--secondary);
            border-radius: 6px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.4rem;
            margin-bottom: 1.8rem;
        }

        .card h3 {
            font-size: 1.35rem;
            font-weight: 700;
            margin-bottom: 1rem;
            color: var(--primary);
        }

        .card p {
            color: var(--text-muted);
            font-size: 1rem;
        }

        /* About Showcase Blocks */
        .showcase-block {
            display: grid;
            grid-template-columns: 1.1fr 0.9fr;
            gap: 5rem;
            align-items: center;
        }

        .showcase-content h3 {
            font-size: 1.8rem;
            font-weight: 700;
            margin-bottom: 1.2rem;
        }

        .showcase-content p {
            color: var(--text-muted);
            font-size: 1.05rem;
            margin-bottom: 1.5rem;
        }

        .metric-row {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 2rem;
            margin-top: 2.5rem;
            border-top: 1px solid var(--border);
            padding-top: 2rem;
        }

        .metric-card h4 {
            font-size: 2.2rem;
            font-weight: 800;
            color: var(--secondary);
        }

        .metric-card p {
            font-size: 0.95rem;
            font-weight: 600;
            color: var(--primary);
        }

        /* Enterprise Contact Layout */
        .contact-panel {
            max-width: 650px;
            margin: 0 auto;
            background: var(--white);
            padding: 3.5rem;
            border-radius: 8px;
            border: 1px solid var(--border);
        }

        .form-element {
            margin-bottom: 1.8rem;
        }

        .form-element label {
            display: block;
            margin-bottom: 0.6rem;
            font-weight: 600;
            font-size: 0.9rem;
            color: var(--primary);
        }

        .form-element input, .form-element textarea {
            width: 100%;
            padding: 0.9rem;
            border: 1px solid #cbd5e1;
            border-radius: 6px;
            background: var(--bg-light);
            font-size: 1rem;
            outline: none;
            transition: all 0.2s;
        }

        .form-element input:focus, .form-element textarea:focus {
            border-color: var(--secondary);
            background: var(--white);
            box-shadow: 0 0 0 4px rgba(37,99,235,0.1);
        }

        .desk-info {
            text-align: center;
            margin-top: 3rem;
            padding-top: 2rem;
            border-top: 1px solid var(--border);
        }

        .desk-info p {
            font-size: 0.85rem;
            text-transform: uppercase;
            letter-spacing: 1px;
            color: var(--text-muted);
            margin-bottom: 0.4rem;
        }

        .desk-info a {
            color: var(--secondary);
            font-weight: 700;
            text-decoration: none;
            font-size: 1.1rem;
        }

        /* Footer Architecture */
        footer {
            background: var(--primary);
            color: #64748b;
            padding: 3rem 2rem;
            text-align: center;
